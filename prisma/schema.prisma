generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user_auth {
  id               Int             @id @default(autoincrement())
  username         String          @unique
  email            String          @unique
  password         String
  role             user_role       @default(CUSTOMER)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  resetToken       String?
  resetTokenExpiry DateTime?
  avatar           String?
  userCart         user_cart?
  userFavorites    user_favorite[]
}

model user_cart {
  id         Int              @id @default(autoincrement())
  user_id    Int              @unique
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt
  user       user_auth        @relation(fields: [user_id], references: [id])
  items      user_cart_item[]
}

model user_cart_item {
  id         Int              @id @default(autoincrement())
  cart_id    Int
  product_id Int
  quantity   Int
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt
  variant_id Int?
  cart       user_cart        @relation(fields: [cart_id], references: [id])
  product    product          @relation(fields: [product_id], references: [id])
  variant    product_variant? @relation(fields: [variant_id], references: [id])

  @@unique([cart_id, product_id, variant_id])
}

model user_favorite {
  id         Int       @id @default(autoincrement())
  user_id    Int
  product_id Int
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  product    product   @relation(fields: [product_id], references: [id])
  user       user_auth @relation(fields: [user_id], references: [id])
  @@unique([user_id, product_id])
}

model category {
  id           Int                    @id @default(autoincrement())
  code         String                 @unique
  created_at   DateTime               @default(now())
  updated_at   DateTime               @updatedAt
  translations category_translation[]
  types        type[]
}

model category_translation {
  id          Int      @id @default(autoincrement())
  category_id Int
  language    Language
  name        String
  category    category @relation(fields: [category_id], references: [id])

  @@unique([category_id, language])
}

model type {
  id           Int                @id @default(autoincrement())
  code         String             @unique
  category_id  Int
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt
  products     product[]
  category     category           @relation(fields: [category_id], references: [id])
  translations type_translation[]
}

model type_translation {
  id       Int      @id @default(autoincrement())
  type_id  Int
  language Language
  name     String
  type     type     @relation(fields: [type_id], references: [id])

  @@unique([type_id, language])
}

model brand {
  id         Int       @id @default(autoincrement())
  name       String
  code       String    @unique
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  image_url  String?
  products   product[]
}

model color {
  id              Int                 @id @default(autoincrement())
  code            String              @unique
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt
  image_url       String?
  translations    color_translation[]
  products        product[]
  produc_variants product_variant[]
}

model color_translation {
  id       Int      @id @default(autoincrement())
  color_id Int
  language Language
  name     String
  color    color    @relation(fields: [color_id], references: [id])

  @@unique([color_id, language])
}

model product {
  id                    Int                    @id @default(autoincrement())
  code                  String                 @unique
  price                 Decimal                @db.Decimal(12, 2)
  discount              Decimal?               @db.Decimal(5, 2)
  type_id               Int
  brand_id              Int?
  color_id              Int?
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  arrival_date          DateTime?
  availability_id       Int?
  stock_profile_id      Int?
  gtin                  String?                @unique
  availability          product_availability?  @relation(fields: [availability_id], references: [id])
  brand                 brand?                 @relation(fields: [brand_id], references: [id])
  color                 color?                 @relation(fields: [color_id], references: [id])
  stock_profile         product_stock_profile? @relation(fields: [stock_profile_id], references: [id])
  type                  type                   @relation(fields: [type_id], references: [id])
  product_attributes    product_attribute[]
  product_audiences     product_audience[]
  product_home_sections product_home_section[]
  images                product_image[]
  stock                 product_stock?
  stock_logs            product_stock_log[]
  translations          product_translation[]
  product_unit_maps     product_unit_map[]
  product_variants      product_variant[]
  cart_items            user_cart_item[]
  favourite             user_favorite[]
}

model product_variant {
  id         Int                     @id @default(autoincrement())
  product_id Int
  color_id   Int?
  price      Decimal?                @db.Decimal(10, 2)
  created_at DateTime                @default(now())
  updated_at DateTime                @updatedAt
  quantity   Int                     @default(0)
  code       String?
  color      color?                  @relation(fields: [color_id], references: [id], onDelete: Cascade)
  product    product                 @relation(fields: [product_id], references: [id], onDelete: Cascade)
  images     product_variant_image[]
  card_items user_cart_item[]

  @@unique([product_id, color_id])
}

model product_variant_image {
  id         Int             @id @default(autoincrement())
  variant_id Int
  url        String
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
  sort_order Int             @default(0)
  variant    product_variant @relation(fields: [variant_id], references: [id], onDelete: Cascade)
}

model product_unit {
  id            Int                        @id @default(autoincrement())
  code          String                     @unique
  created_at    DateTime                   @default(now())
  updated_at    DateTime                   @updatedAt
  product_units product_unit_map[]
  translations  product_unit_translation[]
}

model product_unit_translation {
  id         Int          @id @default(autoincrement())
  unit_id    Int
  language   Language
  name       String
  short_name String?
  unit       product_unit @relation(fields: [unit_id], references: [id])

  @@unique([unit_id, language])
}

model product_unit_map {
  id               Int          @id @default(autoincrement())
  product_id       Int
  unit_id          Int
  quantity_in_base Int
  price            Decimal?               @db.Decimal(12, 2)
  product          product      @relation(fields: [product_id], references: [id])
  unit             product_unit @relation(fields: [unit_id], references: [id])

  @@unique([product_id, unit_id])
}

model measurement_unit {
  id           Int                             @id @default(autoincrement())
  code         String                          @unique
  created_at   DateTime                        @default(now())
  updated_at   DateTime                        @updatedAt
  conversions_from    measurement_unit_conversion[] @relation("fromUnit")
  conversions_to      measurement_unit_conversion[] @relation("toUnit")
  translations measurement_unit_translation[]
  product_attributes product_attribute[]
}

model measurement_unit_translation {
  id         Int                  @id @default(autoincrement())
  unit_id    Int
  language   Language
  name       String?
  short_name String?
  unit       measurement_unit     @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@unique([unit_id, language])
}

model measurement_unit_conversion {
  id             Int                  @id @default(autoincrement())
  from_unit_id   Int
  to_unit_id     Int
  conversion_rate Decimal              @db.Decimal(10, 4)
  from_unit      measurement_unit     @relation("fromUnit", fields: [from_unit_id], references: [id], onDelete: Cascade)
  to_unit        measurement_unit     @relation("toUnit", fields: [to_unit_id], references: [id], onDelete: Cascade)

  @@unique([from_unit_id, to_unit_id])
  @@index([to_unit_id])
}
model product_availability {
  id           Int                                @id @default(autoincrement())
  code         String                             @unique
  created_at   DateTime                           @default(now())
  updated_at   DateTime                           @updatedAt
  products     product[]
  translations product_availability_translation[]
}

model product_availability_translation {
  id              Int                  @id @default(autoincrement())
  availability_id Int
  language        Language
  name            String
  availability    product_availability @relation(fields: [availability_id], references: [id])

  @@unique([availability_id, language])
}

model product_image {
  id         Int      @id @default(autoincrement())
  product_id Int
  url        String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  product    product  @relation(fields: [product_id], references: [id])
}

model product_translation {
  id          Int      @id @default(autoincrement())
  product_id  Int
  language    Language
  name        String
  description String?
  product     product  @relation(fields: [product_id], references: [id])

  @@unique([product_id, language])
}

model product_attribute_type {
  id                 Int                                  @id @default(autoincrement())
  code               String                               @unique
  display_order      Int                                  @default(0)
  created_at         DateTime                             @default(now())
  updated_at         DateTime                             @updatedAt
  product_attributes product_attribute[]
  translations       product_attribute_type_translation[]
}

model product_attribute_type_translation {
  id       Int                    @id @default(autoincrement())
  type_id  Int
  language Language
  name     String
  type     product_attribute_type @relation(fields: [type_id], references: [id])

  @@unique([type_id, language])
}

model product_attribute {
  id           Int                             @id @default(autoincrement())
  product_id   Int
  type_id      Int
  numeric_value Decimal?                        @db.Decimal(10, 2)
  unit_id      Int?
  created_at   DateTime                        @default(now())
  updated_at   DateTime                        @updatedAt
  product      product                         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  type         product_attribute_type          @relation(fields: [type_id], references: [id])
  unit measurement_unit? @relation(fields: [unit_id], references: [id])
  translations product_attribute_translation[]
}

model product_attribute_translation {
  id           Int               @id @default(autoincrement())
  attribute_id Int
  language     Language
  value        String
  attribute    product_attribute @relation(fields: [attribute_id], references: [id], onDelete: Cascade)

  @@unique([attribute_id, language])
}

model audience {
  id                Int                    @id @default(autoincrement())
  code              String                 @unique
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt
  translations      audience_translation[]
  product_audiences product_audience[]
}

model audience_translation {
  id          Int      @id @default(autoincrement())
  audience_id Int
  language    Language
  name        String
  audience    audience @relation(fields: [audience_id], references: [id])

  @@unique([audience_id, language])
}

model product_audience {
  id          Int      @id @default(autoincrement())
  product_id  Int
  audience_id Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  audience    audience @relation(fields: [audience_id], references: [id])
  product     product  @relation(fields: [product_id], references: [id])

  @@index([product_id])
  @@index([audience_id])
}

model home_section {
  id           Int                        @id @default(autoincrement())
  code         String                     @unique
  created_at   DateTime                   @default(now())
  updated_at   DateTime                   @updatedAt
  translations home_section_translation[]
  products     product_home_section[]
}

model home_section_translation {
  id         Int          @id @default(autoincrement())
  section_id Int
  language   Language
  name       String
  section    home_section @relation(fields: [section_id], references: [id])

  @@unique([section_id, language])
}

model product_home_section {
  id         Int          @id @default(autoincrement())
  section_id Int
  product_id Int
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  product    product      @relation(fields: [product_id], references: [id])
  section    home_section @relation(fields: [section_id], references: [id])

  @@unique([section_id, product_id])
  @@index([product_id])
  @@index([section_id])
}

model product_stock {
  id         Int      @id @default(autoincrement())
  product_id Int      @unique
  quantity   Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  product    product  @relation(fields: [product_id], references: [id])
}

model product_stock_profile {
  id                  Int                                 @id @default(autoincrement())
  code                String                              @unique
  low_stock_threshold Int
  created_at          DateTime                            @default(now())
  updated_at          DateTime                            @updatedAt
  products            product[]
  translations        product_stock_profile_translation[]
}

model product_stock_profile_translation {
  id         Int                   @id @default(autoincrement())
  profile_id Int
  language   Language
  name       String
  profile    product_stock_profile @relation(fields: [profile_id], references: [id])

  @@unique([profile_id, language])
}

model product_stock_log {
  id         Int          @id @default(autoincrement())
  product_id Int
  quantity   Int
  type       StockLogType
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  product    product      @relation(fields: [product_id], references: [id])
}

enum user_role {
  ADMIN
  CUSTOMER
}

enum StockLogType {
  IN
  OUT
}

enum Language {
  MN
  EN
  ZH
  RU
  DE
  FR
}
