generator client {
    provider = "prisma-client"
    output   = "../src/generated/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model user_auth {
    id               Int       @id @default(autoincrement())
    username         String    @unique
    email            String    @unique
    password         String
    role             user_role @default(CUSTOMER)
    avatar           String?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt
    resetToken       String?
    resetTokenExpiry DateTime?

    userCart      user_cart?
    userFavorites user_favorite[]
}

enum user_role {
    ADMIN
    CUSTOMER
}

model user_cart {
    id         Int      @id @default(autoincrement())
    user_id    Int      @unique
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    user  user_auth        @relation(fields: [user_id], references: [id])
    items user_cart_item[]
}

model user_cart_item {
    id         Int @id @default(autoincrement())
    cart_id    Int
    product_id Int
    quantity   Int

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    cart    user_cart @relation(fields: [cart_id], references: [id])
    product product   @relation(fields: [product_id], references: [id])
}

model user_favorite {
    id         Int @id @default(autoincrement())
    user_id    Int
    product_id Int

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    user    user_auth @relation(fields: [user_id], references: [id])
    product product   @relation(fields: [product_id], references: [id])
}

model category {
    id   Int    @id @default(autoincrement())
    code String @unique

    translations category_translation[]

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    types type[]
}

model category_translation {
    id          Int      @id @default(autoincrement())
    category_id Int
    language    Language
    name        String

    category category @relation(fields: [category_id], references: [id])

    @@unique([category_id, language])
}

model type {
    id           Int                @id @default(autoincrement())
    translations type_translation[]
    code         String             @unique

    category_id Int
    category    category @relation(fields: [category_id], references: [id])

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    products product[]
}

model type_translation {


    id       Int      @id @default(autoincrement())
    type_id  Int
    language Language
    name     String

    type type @relation(fields: [type_id], references: [id])

    @@unique([type_id, language])
}

model brand {
    id         Int      @id @default(autoincrement())
    name       String
    image_url  String?
    code       String   @unique
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    products product[]
}

model color {
    id           Int                 @id @default(autoincrement())
    translations color_translation[]
    code         String              @unique
    image_url    String?
    created_at   DateTime            @default(now())
    updated_at   DateTime            @updatedAt

    products product[]
}

model color_translation {
    id       Int      @id @default(autoincrement())
    color_id Int
    language Language
    name     String

    color color @relation(fields: [color_id], references: [id])

    @@unique([color_id, language])
}

model product {
    id           Int                   @id @default(autoincrement())
    translations product_translation[]
    code         String                @unique

    price    Float
    discount Float?

    type_id Int
    type    type @relation(fields: [type_id], references: [id])

    brand_id Int?
    brand    brand? @relation(fields: [brand_id], references: [id])

    color_id Int?
    color    color? @relation(fields: [color_id], references: [id])

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    images     product_image[]
    stock      product_stock?
    stock_logs product_stock_log[]

    cart_items            user_cart_item[]
    favourite             user_favorite[]
    availability_id       Int?
    availability          product_availability?  @relation(fields: [availability_id], references: [id])
    stock_profile_id      Int?
    stock_profile         product_stock_profile? @relation(fields: [stock_profile_id], references: [id])
    product_audiences     product_audience[]
    product_home_sections product_home_section[]
    product_attributes    product_attribute[]
        arrival_date DateTime?
product_unit_maps product_unit_map[]
}

model product_unit {
    id            Int                        @id @default(autoincrement())
    code          String                     @unique
    translations  product_unit_translation[]
    product_units product_unit_map[]

    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
}

model product_unit_translation {
    id         Int      @id @default(autoincrement())
    unit_id    Int
    language   Language
    name       String
    short_name String?

    unit product_unit @relation(fields: [unit_id], references: [id])

    @@unique([unit_id, language])
}

model product_unit_map {
    id               Int    @id @default(autoincrement())
    product_id       Int
    unit_id          Int
    quantity_in_base Int
    price            Float?

    product product      @relation(fields: [product_id], references: [id])
    unit    product_unit @relation(fields: [unit_id], references: [id])

    @@unique([product_id, unit_id])
}

model product_availability {
    id           Int                                @id @default(autoincrement())
    code         String                             @unique
    translations product_availability_translation[]
    products     product[]
    created_at   DateTime                           @default(now())
    updated_at   DateTime                           @updatedAt
}

model product_availability_translation {
    id              Int      @id @default(autoincrement())
    availability_id Int
    language        Language
    name            String

    availability product_availability @relation(fields: [availability_id], references: [id])

    @@unique([availability_id, language])
}

model product_image {
    id         Int    @id @default(autoincrement())
    product_id Int
    url        String

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    product product @relation(fields: [product_id], references: [id])
}

model product_translation {
    id          Int      @id @default(autoincrement())
    product_id  Int
    language    Language
    name        String
    description String?

    product product @relation(fields: [product_id], references: [id])

    @@unique([product_id, language])
}

model product_attribute_type {
  id                 Int                                   @id @default(autoincrement())
  code               String                                @unique
  display_order      Int                                   @default(0)

  created_at         DateTime                              @default(now())
  updated_at         DateTime                              @updatedAt

  translations       product_attribute_type_translation[]
  product_attributes product_attribute[]
}

model product_attribute_type_translation {
  id       Int      @id @default(autoincrement())
  type_id  Int
  language Language
  name     String

  type product_attribute_type @relation(fields: [type_id], references: [id])

  @@unique([type_id, language])
}

model product_attribute {
  id         Int @id @default(autoincrement())

  product_id Int
  type_id    Int

  product product @relation(fields: [product_id], references: [id])
  type    product_attribute_type @relation(fields: [type_id], references: [id])

  translations product_attribute_translation[]
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model product_attribute_translation {
  id           Int @id @default(autoincrement())

  attribute_id Int
  language     Language
  value        String

  attribute product_attribute @relation(  fields: [attribute_id], references: [id] )

  @@unique([attribute_id, language])
}
model audience {
    id               Int                @id @default(autoincrement())
    code             String             @unique
    translations     audience_translation[]
    product_audiences product_audience[]
    created_at       DateTime           @default(now())
    updated_at       DateTime           @updatedAt
}

model audience_translation {
    id         Int      @id @default(autoincrement())
    audience_id Int
    language   Language
    name       String

    audience audience @relation(fields: [audience_id], references: [id])

    @@unique([audience_id, language])
}
model product_audience {
    id          Int @id @default(autoincrement())
    product_id  Int
    audience_id Int

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    product  product  @relation(fields: [product_id], references: [id])
    audience audience @relation(fields: [audience_id], references: [id])
    @@index([product_id])
    @@index([audience_id])
}

model home_section {
    id       Int                    @id @default(autoincrement())
    translations     home_section_translation[]
    code     String @unique
    products product_home_section[]
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
}

model home_section_translation {
    id         Int      @id @default(autoincrement())
    section_id Int
    language   Language
    name       String

    section home_section @relation(fields: [section_id], references: [id])

    @@unique([section_id, language])
}
model product_home_section {
    id         Int          @id @default(autoincrement())
    section_id Int
    section    home_section @relation(fields: [section_id], references: [id])
    product_id Int
    product    product      @relation(fields: [product_id], references: [id])
    created_at DateTime     @default(now())
    updated_at DateTime     @updatedAt

    @@unique([section_id, product_id])
    @@index([product_id])
    @@index([section_id])
}

model product_stock {
    id         Int @id @default(autoincrement())
    product_id Int @unique
    quantity   Int

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    product product @relation(fields: [product_id], references: [id])
}

model product_stock_profile {
    id           Int                                 @id @default(autoincrement())
    code         String                              @unique
    translations product_stock_profile_translation[]

    low_stock_threshold Int

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    products product[]
}

model product_stock_profile_translation {
    id         Int      @id @default(autoincrement())
    profile_id Int
    language   Language
    name       String

    profile product_stock_profile @relation(fields: [profile_id], references: [id])

    @@unique([profile_id, language])
}

model product_stock_log {
    id         Int          @id @default(autoincrement())
    product_id Int
    quantity   Int
    type       StockLogType

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    product product @relation(fields: [product_id], references: [id])
}

enum StockLogType {
    IN
    OUT
}

enum Language {
    MN
    EN
    ZH
    RU
    DE
    FR
}
