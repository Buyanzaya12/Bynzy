generator client {
    provider = "prisma-client"
    output   = "../src/generated/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model user_auth {
    id               Int       @id @default(autoincrement())
    username         String    @unique
    email            String    @unique
    password         String
    role             user_role @default(CUSTOMER)
    avatar           String?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt
    resetToken       String?
    resetTokenExpiry DateTime?

    userCart      user_cart?
    userFavorites user_favorite[]
}

enum user_role {
    ADMIN
    CUSTOMER
}

model user_cart {
    id         Int      @id @default(autoincrement())
    user_id    Int      @unique
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    user  user_auth        @relation(fields: [user_id], references: [id])
    items user_cart_item[]
}

model user_cart_item {
    id         Int @id @default(autoincrement())
    cart_id    Int
    product_id Int
    quantity   Int

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    cart    user_cart @relation(fields: [cart_id], references: [id])
    product product   @relation(fields: [product_id], references: [id])
}

model user_favorite {
    id         Int @id @default(autoincrement())
    user_id    Int
    product_id Int

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    user    user_auth @relation(fields: [user_id], references: [id])
    product product   @relation(fields: [product_id], references: [id])
}

model category {
    id   Int    @id @default(autoincrement())
    code String @unique

    translations category_translation[]

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    types type[]
}

model category_translation {
    id          Int      @id @default(autoincrement())
    category_id Int
    language    Language
    name        String

    category category @relation(fields: [category_id], references: [id])

    @@unique([category_id, language])
}

model type {
    id           Int                @id @default(autoincrement())
    translations type_translation[]
    code         String             @unique

    category_id Int
    category    category @relation(fields: [category_id], references: [id])

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    products product[]
}

model type_translation {
    id       Int      @id @default(autoincrement())
    type_id  Int
    language Language
    name     String

    type type @relation(fields: [type_id], references: [id])

    @@unique([type_id, language])
}

model brand {
    id         Int      @id @default(autoincrement())
    name       String
    code       String   @unique
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    products product[]
}

model color {
    id           Int                 @id @default(autoincrement())
    translations color_translation[]
    code         String              @unique

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    products product[]
}

model color_translation {
    id       Int      @id @default(autoincrement())
    color_id Int
    language Language
    name     String

    color color @relation(fields: [color_id], references: [id])

    @@unique([color_id, language])
}

model product {
    id           Int                   @id @default(autoincrement())
    translations product_translation[]
    code         String                @unique

    price    Float
    discount Float?

    type_id Int
    type    type @relation(fields: [type_id], references: [id])

    brand_id Int?
    brand    brand? @relation(fields: [brand_id], references: [id])

    color_id Int?
    color    color? @relation(fields: [color_id], references: [id])

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    images     product_image[]
    stock      product_stock?
    stock_logs product_stock_log[]

    cart_items user_cart_item[]
    favourite  user_favorite[]
}

model product_image {
    id         Int    @id @default(autoincrement())
    product_id Int
    url        String

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    product product @relation(fields: [product_id], references: [id])
}

model product_translation {
    id          Int      @id @default(autoincrement())
    product_id  Int
    language    Language
    name        String
    description String?

    product product @relation(fields: [product_id], references: [id])

    @@unique([product_id, language])
}

model product_stock {
    id         Int @id @default(autoincrement())
    product_id Int @unique
    quantity   Int

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    product product @relation(fields: [product_id], references: [id])
}

model product_stock_log {
    id         Int          @id @default(autoincrement())
    product_id Int
    quantity   Int
    type       StockLogType

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    product product @relation(fields: [product_id], references: [id])
}

enum StockLogType {
    IN
    OUT
}

enum Language {
    MN
    EN
    ZH
    RU
    DE
    FR
}
